# Copia este archivo a ".env" y rellena solo lo que vayas a usar.
# Nunca subas el ".env" real a git ni lo compartas.

# --- Solo necesario a partir del Paso 8 (ejecución) ---
# Deja todo vacío mientras solo uses el scanner: las claves NO hacen falta
# para leer funding rates, solo para abrir posiciones.

BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Hyperliquid usa una wallet (dirección + clave privada de una API wallet dedicada,
# nunca la de tu wallet principal) en vez de API key/secret.
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_API_PRIVATE_KEY=

# --- Alertas (Paso 7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
